          {
            "label": "平台总览",
            "route": "/"
          }
        ]
      }
    ],
    "assets": [
      {
        "section": "个人资产",
        "items": [
          {
            "label": "资产文件",
            "route": "/assets/files"
          },
          {
            "label": "笔记",
            "route": "/assets/notes"
