{
  "name": "AIO Admin Prototype Board",
  "version": "0.2.0",
  "updated": "2026-05-07",
  "designDirection": {
    "style": "dense shadcn admin workbench",
    "tone": "warm utilitarian, asset-management console, not marketing dashboard",
    "densityRule": "first screen must show object, status metrics, primary operation area, and contextual detail",
    "notesReference": "Blinko-inspired quick capture editor plus masonry note stream",
    "antiPatterns": [
      "large empty panels",
      "documentation-style explanation pages",
      "single-column key/value detail pages",
      "top domain axis mixed with left route tree"
    ]
  },
  "canvas": {
    "frameWidth": 1220,
    "frameHeight": 720,
    "layout": "topbar main context axis + left side context tree + edge-to-edge content workspace",
    "componentStyle": "React + source-owned shadcn/ui primitives in @addzero/ui",
    "tableModel": "TanStack Table column defs + global filter + sorting + pagination + row actions"
  },
  "tokens": {
    "canvas": "#e6dfd2",
    "paper": "#f8f5ee",
    "panel": "#fffef9",
    "ink": "#171915",
    "muted": "#727064",
    "line": "#d4ccbd",
    "rail": "#eee8dc",
    "active": "#171915",
    "mint": "#1f7a65",
    "amber": "#c06a22",
    "blue": "#2f638f",
    "rose": "#a54255"
  },
  "domains": [
    {
      "id": "workbench",
      "label": "工作台",
      "defaultRoute": "/"
    },
    {
      "id": "assets",
      "label": "资产",
      "defaultRoute": "/assets/files"
    },
    {
      "id": "runtime",
      "label": "运行",
      "defaultRoute": "/console"
    },
    {
      "id": "plugins",
      "label": "插件",
      "defaultRoute": "/market"
    },
    {
      "id": "system",
      "label": "系统",
      "defaultRoute": "/system"
    }
  ],
  "routeTrees": {
