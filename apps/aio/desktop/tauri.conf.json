{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIO",
  "version": "2026.5.10",
  "identifier": "site.addzero.aio",
  "build": {
    "beforeDevCommand": "npm --prefix front run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix front run build",
    "frontendDist": "front/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIO",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
